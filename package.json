{
  "name": "aidict",
  "private": true,
  "version": "0.1.0",
  "description": "AIDICT — multi-sport intelligence, statistics and prediction platform (personal use).",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "db:test": "node supabase/tests/run-migrations.mjs",
    "prototype": "npm --prefix prototype run dev",
    "db:bundle": "node supabase/build-apply-all.mjs",
    "db:apply": "services/.venv/Scripts/python services/scripts/apply_schema.py",
    "web:dev": "npm run dev -w @aidict/web",
    "web:build": "npm run build -w @aidict/web",
    "db:migrate": "services/.venv/Scripts/python services/scripts/migrate.py"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "@electric-sql/pglite-socket": "^0.3.0"
  },
  "dependencies": {
    "web-push": "^4.0.0"
  }
}

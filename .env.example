# ─────────────────────────────────────────────────────────────────────────────
# AIDICT environment variables. Copy to .env.local at the repository root.
# NEVER commit real values. Server-only keys must never be prefixed NEXT_PUBLIC_.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase → Project Settings → API keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key        # safe in the browser (RLS applies)
SUPABASE_SECRET_KEY=sb_secret_your-key                              # server only: owner bootstrap + audit log
# Legacy names are still read if you have them: NEXT_PUBLIC_SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY

# Supabase → Connect → Connection string → **Session pooler** (works on IPv4 networks).
# Replace [YOUR-PASSWORD] with the database password and remove the brackets.
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-your-region.pooler.supabase.com:5432/postgres

# Football data providers (server-side only)
FOOTBALL_DATA_ORG_TOKEN=your-football-data-org-token        # https://www.football-data.org/client/register
API_FOOTBALL_KEY=your-api-football-key                      # optional · https://dashboard.api-football.com
API_FOOTBALL_DAILY_BUDGET=90                                # keep 10 of the 100 free calls in reserve

# Web Push (optional; generate with `npx web-push generate-vapid-keys`)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=server-only-vapid-private-key

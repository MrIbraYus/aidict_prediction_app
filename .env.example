# ─────────────────────────────────────────────────────────────────────────────
# AIDICT environment variables — copy to .env.local (web) / services/.env (Python).
# NEVER commit real values. Server-only keys must never be prefixed NEXT_PUBLIC_.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key      # GitHub Actions + server code only
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres

# Football data providers (server-side only)
FOOTBALL_DATA_ORG_TOKEN=your-football-data-org-token        # https://www.football-data.org/client/register
API_FOOTBALL_KEY=your-api-football-key                      # https://dashboard.api-football.com
API_FOOTBALL_DAILY_BUDGET=90                                # keep 10 of the 100 free calls in reserve

# Prediction API (FastAPI on Vercel)
AIDICT_API_URL=http://localhost:8000
AIDICT_API_JWT_AUDIENCE=authenticated

# Web Push (generated with `npx web-push generate-vapid-keys`)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=server-only-vapid-private-key
